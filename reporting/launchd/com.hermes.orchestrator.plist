<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hermes.orchestrator</string>

    <!-- launchd corrupts non-ASCII (Korean) UTF-8 bytes in paths it executes, so the
         launcher is a REAL ASCII-path file (~/.hermes-bin/run_role.sh) that itself cd's
         into the repo via the ASCII symlink ~/.hermes-reporting -> the real
         "헤르메스 에이전트 간 통신/reporting" directory. Nothing launchd touches is non-ASCII. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/haris/.hermes-bin/run_role.sh</string>
        <string>orchestrator</string>
    </array>

    <!-- Start at login and keep alive: restart on any non-clean / crash exit. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Throttle restart to avoid crash loops (min seconds between spawns). -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/haris/.hermes-bin/app/logs/orchestrator.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/haris/.hermes-bin/app/logs/orchestrator.err.log</string>
</dict>
</plist>

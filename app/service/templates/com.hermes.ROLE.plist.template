<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hermes.__ROLE__</string>

    <!-- launchd corrupts non-ASCII (Hangul) UTF-8 bytes in paths it executes, and macOS
         TCC denies launchd-spawned agents read access to ~/Desktop file CONTENTS. So the
         operational runtime is mirrored to an ASCII path (__APP__) by install_service.sh,
         and launchd only ever touches ASCII paths. All paths below are substituted at
         install time from ${HOME} — no username is hardcoded. -->
    <key>ProgramArguments</key>
    <array>
        <string>__LAUNCHER__</string>
        <string>__ROLE__</string>
    </array>

    <!-- admin(ceo_admin_runtime.py) 는 에이전트 .md 를 원본 git 워크트리에 쓰고 커밋해야 한다.
         미러(__APP__)에는 .git 이 없으므로, launchd 가 원본 repo 절대경로를 HERMES_REPO 로
         주입한다. 다른 역할도 무해하게 가지고 있어 일관성을 위해 모든 plist 에 동일 주입. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HERMES_REPO</key>
        <string>__REPO__</string>
    </dict>

    <!-- Start at login and keep alive: restart on any non-clean / crash exit. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Throttle restart to avoid crash loops (min seconds between spawns). -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>__LOGS__/__ROLE__.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGS__/__ROLE__.err.log</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bogo.backup</string>

    <!-- While the bots are operating, this periodically auto-backs up the data
         (conversations/accounts/channels/reports) inside the folder. It is the key to removing
         the step where a human presses 'Backup' — when the folder is copied to a new PC, the
         latest backup travels with it, and the new PC auto-restores that backup with a single
         double-click of Start.

         Important (portability): the backup output MUST be written to the migration/ of the
         'source repo' so it moves along when the folder is physically copied. launchd runs the
         ASCII mirror (__APP__), but the backup script is given --out pointing at the 'source
         repo' (__REPO__/migration) so the output lands in the original folder.
         (The mirror is a copy made by install_service.sh via rsync, so it is not the target you
         copy in Finder.)

         Paths are substituted by install_service.sh at install time:
           __APP__  = ASCII mirror app path (where the script runs)
           __REPO__ = source repo app path (output destination = folder-copy target)
           __LOGS__ = mirror logs path -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__APP__/migration/bogo_backup.sh</string>
        <string>--quiet</string>
        <string>--out</string>
        <string>__REPO__/migration</string>
        <string>--retain</string>
        <string>__RETAIN__</string>
    </array>

    <!-- Interval: default 6 hours (21600 seconds). Too frequent burdens disk/IO, too rare
         increases potential data loss → 6 hours is a reasonable balance for unattended operation
         (with 3 retained, up to 18 hours of history). install_service.sh substitutes this from
         BOGO_BACKUP_INTERVAL (__INTERVAL__). -->
    <key>StartInterval</key>
    <integer>__INTERVAL__</integer>

    <!-- Also runs once right after boot/login to guarantee a fresh backup (minimizing the gap
         until the first interval). pg_dump is read-only, so it has no impact on the bots/MM. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- The backup is a one-shot job (start, back up, exit) → no KeepAlive. Even if it fails, it
         retries on the next interval, so there is no crash-loop risk. To avoid overlapping runs,
         launchd only relaunches after the previous instance has exited (the default behavior of
         StartInterval). -->
    <key>ProcessType</key>
    <string>Background</string>

    <!-- Low priority (Nice) so the backup does not interfere with the bots' responsiveness. -->
    <key>Nice</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__LOGS__/backup.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGS__/backup.err.log</string>
</dict>
</plist>

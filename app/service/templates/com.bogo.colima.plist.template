<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bogo.colima</string>

    <!-- Auto-starts Colima (the Docker runtime VM) at macOS login/boot. The communication
         backbone the bots depend on (the Mattermost/Postgres containers) lives only on top of
         Colima → Colima must come up automatically at boot so the containers revive under the
         unless-stopped policy and the bots do not die instantly.
         Paths are substituted by install_service.sh at install time (__COLIMA__ = absolute path
         to the colima binary, __BREW_BIN__ = the PATH where colima finds docker/limactl, etc.). -->
    <key>ProgramArguments</key>
    <array>
        <string>__COLIMA__</string>
        <string>start</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__BREW_BIN__:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <!-- Starts once at boot/login. `colima start` returns immediately and idempotently if it is
         already running, so no KeepAlive (constant re-execution) — colima itself keeps the VM
         daemon alive. RunAtLoad alone satisfies the "auto-start at boot" requirement. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- If start fails (e.g. transient resource shortage), retry but throttle to avoid a
         runaway loop. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>__LOGS__/colima.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGS__/colima.err.log</string>
</dict>
</plist>

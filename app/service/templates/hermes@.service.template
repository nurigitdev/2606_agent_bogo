# systemd user service template for Hermes (Linux).
# Installed as ~/.config/systemd/user/hermes@.service by install_service.sh.
# Linux has no TCC restriction and handles UTF-8 (Hangul) paths natively, so it
# runs the repo IN PLACE — no ASCII mirror needed. %i is the role instance
# (orchestrator|hr|dev|admin):  systemctl --user start hermes@orchestrator
#
# __WORKDIR__ is substituted at install time (the absolute repo path, may contain Hangul).
[Unit]
Description=Hermes agent (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__WORKDIR__
ExecStart=__WORKDIR__/run_role.sh %i
Restart=always
RestartSec=10
# Memory-leak guard: kernel restarts the unit if RSS exceeds the cap.
MemoryMax=1G
# Structured stdout/stderr go to the journal: journalctl --user -u hermes@%i
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

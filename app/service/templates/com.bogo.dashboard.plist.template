<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bogo.dashboard</string>

    <!-- launchd permanently owns the CEO dashboard (ceo_dashboard.py). Previously it was a
         one-off nohup process under oneclick, so it died on every terminal close/sleep/manual
         kill and could not revive → it is promoted to KeepAlive like the 4 bot roles to prevent
         recurrence.
         launchd corrupts Hangul paths and TCC blocks ~/Desktop, so, just like the bots, it only
         runs the launcher (__LAUNCHER__) of the ASCII mirror (__APP__). run_role.sh, given the
         'dashboard' argument, loads .env and then execs ceo_dashboard.py with the venv python.
         All paths are ${HOME}-based and substituted at install time — no hardcoded username. -->
    <key>ProgramArguments</key>
    <array>
        <string>__LAUNCHER__</string>
        <string>dashboard</string>
    </array>

    <!-- BOGO_DASHBOARD_PORT: the dashboard listen port (default 8642). Loopback binding
         (127.0.0.1) is enforced by ceo_dashboard.py via a hardcoded HOST, so there is no
         external-exposure risk.
         BOGO_REPO: injected identically for consistency with the bots (unused by the dashboard
         but harmless). -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>BOGO_DASHBOARD_PORT</key>
        <string>__DASH_PORT__</string>
        <key>BOGO_REPO</key>
        <string>__REPO__</string>
    </dict>

    <!-- Start at login and keep alive: restart on any non-clean / crash exit AND on
         a clean exit too — the dashboard is a long-running server that should never
         voluntarily exit; if it does (kill, slip), launchd must bring it back. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Throttle restart to avoid crash loops (min seconds between spawns). -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>__LOGS__/dashboard.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGS__/dashboard.err.log</string>
</dict>
</plist>

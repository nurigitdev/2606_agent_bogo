[Unit]
# Timer that periodically triggers bogo-backup.service. While the bots operate, it accumulates
# data backups inside the folder in the background, removing the 'double-click Backup' step.
Description=BOGO automatic data backup timer

[Timer]
# First backup 2 minutes after boot (service start) to minimize the first-interval gap, then
# every __INTERVAL_SEC__ seconds.
OnActiveSec=120
OnUnitActiveSec=__INTERVAL_SEC__s
# Intervals missed due to sleep/offline are caught up once right after waking (minimizing data loss).
Persistent=true

[Install]
WantedBy=timers.target

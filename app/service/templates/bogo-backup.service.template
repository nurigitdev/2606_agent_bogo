[Unit]
# BOGO automatic data backup (one-shot) — triggered periodically by bogo-backup.timer.
# Linux runs the repo in-place, so the output also accumulates directly in __WORKDIR__/migration
# (= the path where the backup travels along when the folder is copied via Finder/file manager).
# Being a read-only pg_dump, it has no impact on the bots/MM. This is the key job that removes the
# step where a human presses 'Backup'.
Description=BOGO automatic data backup (conversations/accounts/channels/reports)

[Service]
Type=oneshot
WorkingDirectory="__WORKDIR__"
# --quiet automatic mode; output goes to the repo's migration/, auto-pruned to __RETAIN__ kept.
ExecStart=/usr/bin/env bash "__WORKDIR__/migration/bogo_backup.sh" --quiet --out "__WORKDIR__/migration" --retain __RETAIN__
# Low priority so the backup does not interfere with the bots' responsiveness.
Nice=10
IOSchedulingClass=idle

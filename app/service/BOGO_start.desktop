[Desktop Entry]
Version=1.0
Type=Application
Name=Start BOGO
Name[en]=Start BOGO
Comment=Start all BOGO components + auto-restore data (run once after copying the folder)
Comment[en]=Start all BOGO components and auto-restore data (run once after copying the folder)
# WHY  Double-click entry point (bundled inside the app folder). Exec does not hardcode an absolute
#   path (the install location differs per PC). Instead it runs the sibling start_linux.sh relatively —
#   start_linux.sh no longer has its own core and delegates to the root 'BOGO_start.sh'
#   (full core = bogo_oneclick.sh start), so whether you start via this .desktop or via the root entry
#   point the result is completely identical (behavior branching removed:
#   venv→reindex→infra→data auto-restore→bots/dashboard always-on→health check).
#   Terminal=true lets the user watch the install/startup logs and confirm progress/blockers.
# Recommended path: to launch it cleanly from an app menu / file manager icon, run
#   ./app/install_desktop_launcher.sh once from the project root; it installs a .desktop into
#   ~/.local/share/applications with the trust flag set. This bundled copy is for direct double-click within its folder.
# Usage (first time only): this .desktop file and start_linux.sh must sit together in the app directory.
#   Double-click in the file manager → "Trust / Allow launching" once → proceed in the terminal window.
#   Some desktop environments require right-clicking the .desktop and enabling "Allow Launching" first.
Exec=bash -c 'cd "$(dirname "$(readlink -f "%k")")" && bash ./start_linux.sh; echo; echo "[BOGO] Press Enter to exit."; read _'
Terminal=true
Categories=Utility;Network;
Keywords=BOGO;Mattermost;bot;dashboard;

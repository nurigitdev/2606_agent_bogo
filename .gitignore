# ──────────────────────────────────────────────
# 시크릿 / 로컬 데이터 — 절대 커밋 금지
# ──────────────────────────────────────────────
.env
**/.env

# 봇 토큰·API 키가 들어있는 설정 파일 (*.example 만 커밋 허용)
*_config.json
!*_config.json.example
# 데모 로그인 계정(PBKDF2 해시만, 평문 비번 없음) — 이식성 위해 추적 허용
!app/accounts_config.json

channels.json
!channels.json.example

# 일반 직원 명단(초기 비밀번호 평문 포함 — 시크릿). *.example 만 커밋 허용.
employees.json
!employees.json.example

memory_*.json

# ──────────────────────────────────────────────
# 백업 / 임시 파일
# ──────────────────────────────────────────────
backup_*/
*.bak
# 데이터 이전 백업 산출물(대화/계정/보고 실데이터 — git 추적 금지, USB/직접 전달로 이동).
app/migration/bogo_backup_*.tar.gz
app/migration/.bogo_restored

# ──────────────────────────────────────────────
# 빌드 · 런타임 아티팩트
# ──────────────────────────────────────────────
.venv/
venv/
.venv_*/
# QA 스크린샷·검증 산출물(로컬 전용 — git 추적 금지)
artifacts/
__pycache__/
*.pyc
.ruff_cache/
**/.ruff_cache/

# 로그
logs/
app/logs/
# 터미널 폴백 로그(파일관리자 더블클릭 시 터미널 미탐지 폴백 산출물)
BOGO_start_log.txt

# DB
hub/hub.db

# Vault RAG 로컬 인덱스(파생물 — 재생성 가능, 대용량). Vault md 노트는 커밋, 인덱스는 제외.
app/vault/.rag_index.db
app/vault/.rag_index.db-*
**/.rag_index.db
**/.rag_index.db-*
# Vault writer 임시·락 파일(런타임 전용)
app/vault/**/*.lock

